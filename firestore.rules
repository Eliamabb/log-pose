rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/state/main {
   function owner() {
    return request.auth != null && request.auth.uid == uid;
   }
   function validDocument() {
    return request.resource.data.keys().hasOnly(['payload', 'revision', 'mutationId'])
     && request.resource.data.payload is string
     && request.resource.data.payload.size() <= 800000
     && request.resource.data.revision is int
     && request.resource.data.mutationId is string
     && request.resource.data.mutationId.size() == 36;
   }
   allow get: if owner();
   allow create: if owner() && validDocument()
     && request.resource.data.revision == 1;
   allow update: if owner() && validDocument()
     && request.resource.data.revision == resource.data.revision + 1;
   allow list, delete: if false;
  }
 }
}
